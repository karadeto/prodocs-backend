# ── Database ──
DATABASE_URL=postgresql://prodocs:prodocs@localhost:5432/prodocs

# ── Auth (from Supabase project settings -> API -> JWT secret) ──
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── LLM ──
# Plain OpenAI:
OPENAI_API_KEY=sk-...
EXTRACT_MODEL=openai:gpt-4.1-mini
CHAT_MODEL=openai:gpt-4.1
# Or Azure OpenAI (model string "azure:<deployment-name>"):
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# EXTRACT_MODEL=azure:gpt-4.1-mini
# CHAT_MODEL=azure:gpt-4.1

# ── Embeddings ──
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Storage: Cloudflare R2 (leave S3_ENDPOINT_URL unset for local-disk dev mode) ──
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=prodocs
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...

CORS_ORIGINS=["http://localhost:3000"]
